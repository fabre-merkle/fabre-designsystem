            "$value": "round({brand.typography.paragraph.sm.size} * 1.3)",
            "$type": "lineHeight",
            "$description": "Line height for the sm paragraph style, derived from the sm paragraph size."
          },
          "size": {
            "$value": "round({web.fontSize.scale} * 0.875)",
            "$type": "dimension",
            "$description": "Font size for the sm paragraph style at the active breakpoint."
          },
          "weight": {
            "$value": "{brand.typography.paragraph.fontWeight.400}",
            "$type": "fontWeight",
            "$description": "Font weight for the sm paragraph style."
          }
        },
        "xs": {
          "letterspacing": {
            "$value": "round_to({brand.typography.paragraph.xs.size} * 0, 2)",
            "$type": "letterSpacing",
            "$description": "Letter spacing for the xs paragraph style, derived from the xs paragraph size."
          },
          "lineHeight": {
            "$value": "round({brand.typography.paragraph.xs.size} * 1.3)",
            "$type": "lineHeight",
            "$description": "Line height for the xs paragraph style, derived from the xs paragraph size."
          },
          "size": {
            "$value": "round({web.fontSize.scale} * 0.75)",
            "$type": "dimension",
            "$description": "Font size for the xs paragraph style at the active breakpoint."
          },
          "weight": {
            "$value": "{brand.typography.paragraph.fontWeight.400}",
            "$type": "fontWeight",
            "$description": "Font weight for the xs paragraph style."
          }
        }
      },
      "scale": {
        "base": {
          "fontSize": {
            "lg": {
              "$value": "18px",
              "$type": "dimension",
              "$description": "Per-breakpoint base body size in px. All variant sizes are computed as multipliers of this. md is the canonical reference; sm shrinks for mobile, lg grows for wide layouts."
            },
            "md": {
              "$value": "16px",
              "$type": "dimension",
              "$description": "Base body font size at the md breakpoint."
            },
            "sm": {
              "$value": "14px",
              "$type": "dimension",
              "$description": "Base body font size at the sm breakpoint."
            }
          }
        }
      }
    }
  }
}
