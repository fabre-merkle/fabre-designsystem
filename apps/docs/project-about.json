          "version": {
            "kind": "package",
            "name": "@tokens-studio/studio-cli",
            "directories": ["packages/tokens"]
          }
        }
      ]
    },
    {
      "id": "about-components",
      "title": "Components",
      "entries": [
        {
          "id": "about-base-ui",
          "name": "Base UI",
