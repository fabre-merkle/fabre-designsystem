{
  "schemaVersion": 1,
  "groups": [
    {
      "id": "about-framework",
      "title": "Framework and monorepo",
      "entries": [
        {
          "id": "about-nextjs",
          "name": "Next.js",
          "role": "Runs the React applications and documentation site.",
          "href": "https://nextjs.org/docs",
          "version": {
            "kind": "package",
            "name": "next",
            "directories": ["apps/web", "apps/docs"]
          }
        },
        {
          "id": "about-react",
          "name": "React",
          "role": "Composes interactive interfaces from reusable components.",
          "href": "https://react.dev/",
          "version": {
            "kind": "package",
            "name": "react",
            "directories": ["apps/web", "apps/docs"]
          }
        },
        {
          "id": "about-typescript",
          "name": "TypeScript",
          "role": "Checks typed application and component source.",
          "href": "https://www.typescriptlang.org/docs/",
          "version": {
            "kind": "package",
            "name": "typescript",
            "directories": [".", "apps/docs", "packages/ui"]
          }
        }
      ]
    },
    {
